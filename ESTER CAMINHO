<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="styles.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Chakra+Petch&display=swap" rel="stylesheet">
    <title>Aventura Épica</title>
</head>

<body>
    <!-- Tela de Capa -->
    <section class="tela-capa">
        <h1 class="titulo-aventura">Aventura Épica: O Portal Secreto</h1>
        <p class="descricao">Prepare-se para embarcar em uma jornada inesquecível! Sua missão está prestes a começar.</p>
        <button class="btn-iniciar" onclick="iniciarJogo()">Iniciar Aventura</button>
    </section>

    <!-- Tela de História (Será visível após o início) -->
    <section id="historia" class="historia" style="display: none;">
        <h2>Início da Jornada</h2>
        <p>Bem-vindo, herói! Você está diante de um portal misterioso...</p>
    </section>

    <script>
        function iniciarJogo() {
            document.querySelector('.tela-capa').style.display = 'none';
            document.querySelector('#historia').style.display = 'block';
        }
    </script>
</body>

</html>
